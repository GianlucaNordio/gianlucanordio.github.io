---
// A list of notes, one "date  title" row per note, grouped by year unless
// byYear is false. Expects `notes` sorted newest first (see getNotes in site.js).
import { formatDate } from '../site.js';

const { notes, byYear = true } = Astro.props;
const yearOf = (note) => note.data.date.getUTCFullYear();
const groups = byYear
  ? [...new Set(notes.map(yearOf))].map((year) => ({ year, notes: notes.filter((note) => yearOf(note) === year) }))
  : [{ year: null, notes }];
---

{
  groups.map((group) => (
    <section class="year">
      {group.year && <h2>{group.year}</h2>}
      <ul class="note-list">
        {group.notes.map((note) => (
          <li>
            <time datetime={formatDate(note.data.date)}>{formatDate(note.data.date)}</time>
            <span>
              <a href={`/notes/${note.id}/`} lang={note.data.lang}>{note.data.title}</a>
              {note.data.draft && <span class="draft">draft</span>}
            </span>
          </li>
        ))}
      </ul>
    </section>
  ))
}
