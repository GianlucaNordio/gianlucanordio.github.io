---
// The light/dark switch in the header: two cells, the active one filled in.
// Without a choice the site follows the system setting. A choice is stored in
// the browser (localStorage) and is applied on every page by the small script
// in the <head> of Base.astro. Which cell looks filled is decided in
// global.css, from the colours actually in use.
// The switch starts hidden, so nothing dead is shown if JavaScript is off.
---

<div class="theme-toggle" role="group" aria-label="Colour theme" hidden>
  <button type="button" data-theme-choice="light">Light</button>
  <button type="button" data-theme-choice="dark">Dark</button>
</div>

<script is:inline>
  {
    const root = document.documentElement;
    const toggle = document.querySelector('.theme-toggle');
    const buttons = toggle.querySelectorAll('button');
    const systemDark = matchMedia('(prefers-color-scheme: dark)');
    const system = () => (systemDark.matches ? 'dark' : 'light');

    // Tell screen readers which of the two is on.
    const sync = () => {
      const current = root.dataset.theme || system();
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeChoice === current)));
    };

    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const choice = button.dataset.themeChoice;
        try {
          if (choice === system()) {
            // The same as the system setting: forget the choice and follow it.
            delete root.dataset.theme;
            localStorage.removeItem('theme');
          } else {
            root.dataset.theme = choice;
            localStorage.setItem('theme', choice);
          }
        } catch {
          // Storage can be blocked (private mode): the switch still works on this page.
          root.dataset.theme = choice;
        }
        sync();
      }),
    );

    systemDark.addEventListener('change', sync);
    sync();
    toggle.hidden = false;
  }
</script>
