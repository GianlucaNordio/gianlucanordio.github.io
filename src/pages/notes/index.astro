---
// /notes/: every note, newest first, grouped by year.
import Base from '../../layouts/Base.astro';
import NoteList from '../../components/NoteList.astro';
import { getNotes } from '../../site.js';

const notes = await getNotes();
---

<Base title="Notes" description="All notes, newest first.">
  <h1>Notes</h1>
  {notes.length > 0 ? <NoteList notes={notes} /> : <p>No notes yet.</p>}
</Base>
