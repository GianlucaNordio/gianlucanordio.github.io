---
// /projects/: every project on one page, newest first, one slip each.
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getProjects } from '../site.js';

// https://www.linkedin.com/posts/...-activity-123-... -> the embed address of that post.
function linkedinEmbed(url) {
  const match = url?.match(/(activity|ugcPost)[-:](\d+)/);
  return match && `https://www.linkedin.com/embed/feed/update/urn:li:${match[1]}:${match[2]}`;
}

const projects = await Promise.all(
  (await getProjects()).map(async (project) => ({
    ...project,
    Content: (await render(project)).Content,
  })),
);
---

<Base title="Projects" description="Things I have built." bare>
  <h1 class="page-title"><span class="tape">Projects</span></h1>
  <div class="project-stack">
    {
      projects.map(({ id, data, body, Content }) => (
        <article class="slip project" id={id}>
          <span class="kicker">{data.year}</span>
          <h2>
            {data.title}
            {data.draft && <span class="draft">draft</span>}
          </h2>
          {data.tech.length > 0 && (
            <ul class="chips" aria-label="Technologies">
              {data.tech.map((tech) => (
                <li class="chip">{tech}</li>
              ))}
            </ul>
          )}
          <div class="prose">{body?.trim() ? <Content /> : <p>{data.description}</p>}</div>
          {data.images.map((picture) => (
            <figure>
              <Image
                src={picture.src}
                alt={picture.alt}
                widths={[400, 700, 1000]}
                sizes="(max-width: 46rem) 100vw, 42rem"
              />
              {picture.caption && <figcaption>{picture.caption}</figcaption>}
            </figure>
          ))}
          {data.linkedin && (
            <iframe
              class="linkedin-embed"
              src={linkedinEmbed(data.linkedin)}
              title={`LinkedIn post: ${data.title}`}
              loading="lazy"
              allowfullscreen
            />
          )}
          {(data.repo || data.link || data.linkedin) && (
            <p class="project-links">
              {data.repo && <a class="btn btn-tape btn-sm" href={data.repo}>Code ↗</a>}
              {data.link && <a class="btn btn-paper btn-sm" href={data.link}>Link ↗</a>}
              {data.linkedin && <a class="btn btn-paper btn-sm" href={data.linkedin}>LinkedIn post ↗</a>}
            </p>
          )}
        </article>
      ))
    }
  </div>
</Base>
