---
// /projects/: every project on one page, newest first.
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getProjects } from '../site.js';

const projects = await Promise.all(
  (await getProjects()).map(async (project) => ({
    ...project,
    Content: (await render(project)).Content,
  })),
);
---

<Base title="Projects" description="Things I have built.">
  <h1>Projects</h1>
  {
    projects.map(({ id, data, body, Content }) => (
      <article class="project" id={id}>
        <h2>
          {data.title}
          {data.draft && <span class="draft">draft</span>}
        </h2>
        <p class="meta">
          <span>{data.year}</span>
          {data.tech.length > 0 && <span>{data.tech.join(' · ')}</span>}
        </p>
        <div class="prose">{body?.trim() ? <Content /> : <p>{data.description}</p>}</div>
        {(data.repo || data.note || data.link) && (
          <p class="project-links">
            {data.repo && <a href={data.repo}>Code</a>}
            {data.note && <a href={`/notes/${data.note}/`}>Write-up</a>}
            {data.link && <a href={data.link}>Link</a>}
          </p>
        )}
      </article>
    ))
  }
</Base>
