---
// /projects/: every project on one page, newest first.
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getProjects } from '../site.js';

// https://www.linkedin.com/posts/...-activity-123-... -> the embed address of that post.
function linkedinEmbed(url) {
  const match = url?.match(/(activity|ugcPost)[-:](\d+)/);
  return match && `https://www.linkedin.com/embed/feed/update/urn:li:${match[1]}:${match[2]}`;
}

const projects = await Promise.all(
  (await getProjects()).map(async (project) => ({
    ...project,
    Content: (await render(project)).Content,
  })),
);
---

<Base title="Projects" description="Things I have built.">
  <h1>Projects</h1>
  {
    projects.map(({ id, data, body, Content }) => (
      <article class="project" id={id}>
        <h2>
          {data.title}
          {data.draft && <span class="draft">draft</span>}
        </h2>
        <p class="meta">
          <span>{data.year}</span>
          {data.tech.length > 0 && <span>{data.tech.join(' · ')}</span>}
        </p>
        <div class="prose">{body?.trim() ? <Content /> : <p>{data.description}</p>}</div>
        {data.images.map((picture) => (
          <figure>
            <Image src={picture.src} alt={picture.alt} widths={[400, 700, 1000]} sizes="(max-width: 720px) 100vw, 650px" />
            {picture.caption && <figcaption>{picture.caption}</figcaption>}
          </figure>
        ))}
        {data.linkedin && (
          <iframe
            class="linkedin-embed"
            src={linkedinEmbed(data.linkedin)}
            title={`LinkedIn post: ${data.title}`}
            loading="lazy"
            allowfullscreen
          />
        )}
        {(data.repo || data.note || data.link || data.linkedin) && (
          <p class="project-links">
            {data.repo && <a href={data.repo}>Code</a>}
            {data.note && <a href={`/notes/${data.note}/`}>Write-up</a>}
            {data.link && <a href={data.link}>Link</a>}
            {data.linkedin && <a href={data.linkedin}>LinkedIn post</a>}
          </p>
        )}
      </article>
    ))
  }
</Base>
