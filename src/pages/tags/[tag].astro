---
// One page per tag: /tags/<tag>/
import Base from '../../layouts/Base.astro';
import NoteList from '../../components/NoteList.astro';
import { getNotes } from '../../site.js';

export async function getStaticPaths() {
  const notes = await getNotes();
  const tags = [...new Set(notes.flatMap((note) => note.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { notes: notes.filter((note) => note.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { notes } = Astro.props;
---

<Base title={`#${tag}`} description={`Notes tagged ${tag}.`}>
  <h1 class="tag-title">#{tag}</h1>
  <NoteList notes={notes} />
</Base>
