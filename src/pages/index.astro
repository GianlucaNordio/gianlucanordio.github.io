---
// Home page: intro, the latest notes and a selection of projects.
import Base from '../layouts/Base.astro';
import NoteList from '../components/NoteList.astro';
import { SITE, getNotes, getProjects } from '../site.js';

const notes = (await getNotes()).slice(0, 5);

// Projects marked `featured: true`; if none is, the three most recent.
const projects = await getProjects();
const featured = projects.filter((project) => project.data.featured);
const selected = featured.length ? featured : projects.slice(0, 3);
---

<Base>
  <h1 class="sr-only">{SITE.title}</h1>
  <div class="intro">
    <p>
      I'm Gianluca Nordio, a robotics software engineer at Robotize in Copenhagen. I work on ROS 2,
      perception and mobile robots. Here is my <a href="/cv/">CV</a>.
    </p>
    <p>
      This site holds my notes and projects: technical write-ups, things I have built, and essays on
      books and endurance sport. Some are in English, some in Italian.
    </p>
  </div>

  {
    notes.length > 0 && (
      <section class="home-section">
        <div class="section-head">
          <h2>Recent notes</h2>
          <a href="/notes/">All notes</a>
        </div>
        <NoteList notes={notes} byYear={false} />
      </section>
    )
  }

  <section class="home-section">
    <div class="section-head">
      <h2>Projects</h2>
      <a href="/projects/">All projects</a>
    </div>
    <ul class="note-list">
      {
        selected.map((project) => (
          <li>
            <time datetime={String(project.data.year)}>{project.data.year}</time>
            <span>
              <a href={`/projects/#${project.id}`}>{project.data.title}</a>
              <span class="summary">{project.data.description}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
